# ==========================================
# instOS - Environment Configuration
# ==========================================

# Server & Runtime
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api/v1
LOG_LEVEL=info

# Database Configuration (PostgreSQL)
# For local dev / Docker Compose:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/instos?schema=public"
# For automated tests (disposable test database):
DATABASE_TEST_URL="postgresql://postgres:postgres@localhost:5432/instos_test?schema=public"

# Authentication & Security
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="instos-dev-super-secret-jwt-key-min-32-chars-long"
JWT_EXPIRES_IN="12h"
PASSWORD_SALT_ROUNDS=10

# CORS Allowed Origins
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"

# Frontend Vite Public API URL
VITE_API_URL="http://localhost:4000/api/v1"

# ------------------------------------------
# Free-Tier Cloud Integrations (Optional)
# If empty, the system automatically falls back to local simulation
# ------------------------------------------

# 1. Resend API (Transactional Email - Free 3,000 emails/month)
# Get your free key at: https://resend.com
RESEND_API_KEY=""
RESEND_FROM_EMAIL="instOS Support <onboarding@resend.dev>"

# 2. Cloudinary (Ticket Screenshots & Attachments - Free 25 credits/month)
# Get credentials at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# 3. Redis / Upstash (Optional Cache & Distributed Rate Limiter)
# Free Upstash Redis at: https://upstash.com
REDIS_URL=""

# 4. Outbox Worker Configuration
OUTBOX_POLL_INTERVAL_MS=1500
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_STALE_THRESHOLD_MS=300000

# 5. SLA Escalation Engine
SLA_POLL_INTERVAL_MS=10000
